# ── Servidor ──────────────────────────────────────────────────
PORT=3000
CLIENT_URL=http://localhost:5173

# ── Autenticación JWT ─────────────────────────────────────────
# Genera uno propio con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1h

# ── Base de datos (PostgreSQL) ────────────────────────────────
DB_HOST=localhost
DB_PORT=5435
DB_USER=admin
DB_PASSWORD=mallaufro
DB_NAME=mallaufro
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ── IA (Google Gemini) ────────────────────────────────────────
# Obtén tu clave en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu-clave-de-api-de-gemini
GEMINI_MODEL=gemini-2.5-flash
