{
  "name": "fro-path",
  "version": "0.1.0",
  "private": true,
  "description": "Visualizador interactivo de progreso academico para carreras de la UFRO.",
  "license": "MIT",
  "engines": {
    "node": "24.14.1",
    "npm": "11.11.0"
  },
  "workspaces": [
    "apps/client",
    "apps/server",
    "packages/common",
    "packages/database"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev:client": "npm run dev --workspace=@fro-path/client",
    "dev:server": "npm run start:dev --workspace=@fro-path/server",
    "build": "npm run build --workspaces",
    "build:client": "npm run build --workspace=@fro-path/client",
    "build:server": "npm run build --workspace=@fro-path/server",
    "build:common": "npm run build --workspace=@fro-path/common",
    "test": "npm run test --workspace=@fro-path/server",
    "test:client": "npm run test --workspace=@fro-path/client -- --run",
    "test:all": "npm run test --workspace=@fro-path/server && npm run test:client",
    "test:cov:server": "npm run test:cov --workspace=@fro-path/server",
    "test:cov:client": "npm run test:coverage --workspace=@fro-path/client",
    "test:cov:all": "npm run test:cov:server && npm run test:cov:client",
    "lint": "npm run lint --workspaces"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jcidvidal/FRO-Path.git"
  },
  "keywords": [
    "ufro",
    "malla-curricular",
    "progreso-academico",
    "react",
    "nestjs",
    "typescript"
  ],
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}